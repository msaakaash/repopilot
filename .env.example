# Choose "gemini" or "openrouter" and configure the matching model and key.
LLM_PROVIDER=gemini

# Gemini settings (used when LLM_PROVIDER=gemini).
LLM_MODEL=REPLACE_WITH_SUPPORTED_MODEL
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# OpenRouter settings (used when LLM_PROVIDER=openrouter).
OPENROUTER_MODEL=REPLACE_WITH_SUPPORTED_MODEL
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY

# Local Docker Compose services.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me
POSTGRES_URL=postgresql+asyncpg://postgres:1234@localhost:5432/repopilot

# Optional: required only for GitHub-backed custom questions.
GITHUB_TOKEN=
# Read-only GitHub MCP server used by the investigation agent for custom questions.
# The token is passed to the MCP process as GITHUB_PERSONAL_ACCESS_TOKEN by default.
GITHUB_MCP_COMMAND=npx
GITHUB_MCP_ARGS=-y,@modelcontextprotocol/server-github
GITHUB_MCP_TOKEN_ENV=GITHUB_PERSONAL_ACCESS_TOKEN

# Optional runtime limits and workspace location.
WORKSPACE_ROOT=./data/workspaces
MAX_REPAIR_ATTEMPTS=2
EXECUTION_TIMEOUT_SECONDS=600
MAX_REPOSITORY_MB=250
